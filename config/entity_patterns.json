{
  "patterns": [
    {"type": "url", "regex": "https?://[a-zA-Z0-9\\-._~:/?#\\[\\]@!$&'()*+,;=]+"},
    {"type": "paper_id", "regex": "(?<!\\d)\\d{4}\\.\\d{4,5}(?!\\d)"},
    {"type": "ip_address", "regex": "\\b(?:\\d{1,3}\\.){3}\\d{1,3}\\b"},
    {"type": "error_code", "regex": "\\b(?:ORA|PLS|SP2|TNS|HTTP|OCI)-?\\d{3,6}\\b"},
    {"type": "version", "regex": "\\bv?[0-9]+\\.[0-9]+(?:\\.[0-9]+)*\\b"},
    {"type": "file_name", "regex": "\\b[a-zA-Z][a-zA-Z0-9_-]*\\.[a-zA-Z0-9]{1,8}\\b"},
    {"type": "api_name", "regex": "\\b[a-zA-Z][a-zA-Z0-9_]*\\(\\)\\b"},
    {"type": "identifier", "regex": "\\b[a-zA-Z][a-zA-Z0-9]*_[a-zA-Z0-9_]+\\b"},
    {"type": "identifier", "regex": "\\b[a-zA-Z][a-zA-Z0-9]*=[a-zA-Z0-9_.-]+\\b"},
    {"type": "identifier", "regex": "\\b[a-zA-Z0-9.-]+:\\d+\\b"},
    {"type": "identifier", "regex": "\\b[A-Z][A-Z0-9]{2,}(?:[-_][A-Z0-9]+)*\\b"},
    {"type": "identifier", "regex": "(?:日本オラクル|Oracle)"}
  ]
}
